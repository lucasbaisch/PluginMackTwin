<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>PluginCAISM-Setup</OutputName>
    <OutputType>Package</OutputType>
    <!-- InstallerPlatform = arquitetura do MSI. Platforms = a plataforma MSBuild,
         que precisa casar com o 'Any CPU' da solução; sem isso o build da solução
         ignora este projeto silenciosamente e nenhum MSI é gerado. -->
    <InstallerPlatform>x64</InstallerPlatform>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- Garante que o plugin seja compilado ANTES de o instalador empacotar o bin\.
         Não é referência de assembly: o WiX só consome os arquivos de saída, e é
         daqui que sai a variável $(var.PluginCAISM.TargetDir) usada no Package.wxs
         (por isso o MSI segue automaticamente a configuração Debug/Release). -->
    <ProjectReference Include="..\PluginCAISM\PluginCAISM.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
