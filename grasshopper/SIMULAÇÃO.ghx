                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10"># -*- coding: utf-8 -*-
# =============================================================================
# GhPython Script Component - Pipeline unificado (multiplas cenas + assentos)
# =============================================================================
# Faz, em um unico componente: agrupamento dos objetos do Rhino por LAYER de
# cena, explosao de blocos em meshes rastreaveis (uma vez por cena, com cache),
# construcao das linhas via SDL a partir dos vetores do Vector Star do
# Pufferfish, interseccao linha x mesh com prefiltro por bounding box, selecao
# do hit mais proximo por raio, selecao do vetor mais alinhado com a direcao de
# cada assento (dot product), e persistencia de um JSON por assento.
#
# O Vector Star continua sendo o componente nativo do Pufferfish no canvas -
# este script so recebe os vetores ja prontos como input.
#
# -----------------------------------------------------------------------------
# ENTRADAS (configurar Access e Type hint conforme a tabela)
# -----------------------------------------------------------------------------
#   block_instances : List | Guid      - TODOS os objetos das 3 cenas juntos.
#                                        O script separa por layer raiz.
#   origin_point    : List | Point3d   - uma origem por registro
#   forward_vec     : List | Vector3d  - uma direcao por registro
#   seat_name       : List | str       - um nome de assento por registro
#   scene_name      : List | str       - codigo da cena por registro ("01"...)
#   vectors         : List | Vector3d  - saida "Vectors" do Vector Star.
#                                        LISTA UNICA, compartilhada por todos
#                                        os assentos (ver nota abaixo).
#   ray_length      : Item | float     - comprimento de cada raio (SDL)
#   output_folder   : Item | str       - pasta onde salvar/ler os JSONs
#   run             : Item | bool      - liga o processamento pesado
#
# origin_point, forward_vec, seat_name e scene_name PRECISAM ter o mesmo
# tamanho (sao listas paralelas, ja repetidas pelo componente anterior).
# Achate (Flatten) as quatro.
#
# -----------------------------------------------------------------------------
# NOTA SOBRE O VECTOR STAR
# -----------------------------------------------------------------------------
# As direcoes do star sao IDENTICAS para qualquer origem - a origem so serve
# para o componente desenhar as linhas de preview. Portanto:
#
#   - alimente o Vector Star com UM UNICO ponto (0,0,0);
#   - use SOMENTE a saida "Vectors"; ignore a saida de linhas;
#   - ligue essa lista direto neste input, sem graft.
#
# As linhas de fato usadas no raycast sao construidas aqui dentro, uma por
# assento, ja com o comprimento de ray_length.
#
# -----------------------------------------------------------------------------
# LAYERS ESPERADAS NO RHINO
# -----------------------------------------------------------------------------
#   "CENÁRIO 01", "CENÁRIO 02", "CENÁRIO 03"
#
# A comparacao e feita por TOKEN normalizado (minusculas, sem acento, so
# alfanumerico): "CENÁRIO 01" -&gt; "cenario01". Isso evita depender do encoding
# do arquivo .py ou de como o nome foi digitado no Rhino. Sublayers
# ("CENÁRIO 01::Cadeiras") caem no grupo da layer raiz.
#
# -----------------------------------------------------------------------------
# SAIDAS
# -----------------------------------------------------------------------------
#   Meshes, Names, Ids       : (so quando run=True) explosao de TODAS as cenas
#                              concatenada
#   MeshScenes               : token da cena de cada mesh, paralelo a Meshes
#   JsonPaths                : caminho do JSON de cada registro
#   SeatNames                : eco de seat_name, na ordem original dos registros
#   SceneNames               : eco de scene_name, na ordem original
#   NearestIndexList         : indice do vetor do star mais alinhado
#   NearestPointList         : ponto de hit correspondente (ou None)
#   NearestNameList/IdList   : identidade do elemento atingido nessa direcao
#   Diagnostic               : log de execucao passo a passo
#
# Cada JSON contem: scene_name, seat_name, origin, forward_vector, a lista
# completa de raios (todas as direcoes do star, com hit/ponto/nome/id) e o
# resumo do "nearest".
#
# Quando run=False, a parte pesada e pulada e cada registro tenta carregar o
# JSON ja salvo, usando o mesmo nome de arquivo (scene_name + seat_name).
# =============================================================================

import Rhino
import Rhino.Geometry as rg
from Rhino.Geometry.Intersect import Intersection
import traceback
import uuid
import json
import io
import os
import time

try:
    import unicodedata
    HAS_UNICODEDATA = True
except ImportError:
    HAS_UNICODEDATA = False


# ---------------------------------------------------------------------------
# Compatibilidade IronPython 2.7 (Rhino 7) x CPython 3 (Rhino 8)
# ---------------------------------------------------------------------------

try:
    TEXT_TYPE = unicode          # noqa: F821  - existe apenas no Python 2
    BYTES_TYPE = str
except NameError:
    TEXT_TYPE = str
    BYTES_TYPE = bytes


def to_text(value):
    """Converte qualquer coisa para texto unicode, tentando varios encodings
    antes de desistir. Necessario porque nomes de blocos e de layers digitados
    em portugues chegam como bytes em IronPython e estouram o
    DecoderFallbackException na hora de serializar o JSON."""
    if value is None:
        return u""
    if isinstance(value, TEXT_TYPE):
        return value
    if isinstance(value, BYTES_TYPE):
        for encoding in ("utf-8", "cp1252"):
            try:
                return value.decode(encoding)
            except (UnicodeDecodeError, AttributeError):
                pass
        return value.decode("latin-1", "replace")
    return TEXT_TYPE(str(value))


# Fallback manual, usado so se unicodedata nao estiver disponivel.
ACCENT_MAP = {
    u"á": u"a", u"à": u"a", u"ã": u"a", u"â": u"a", u"ä": u"a",
    u"é": u"e", u"è": u"e", u"ê": u"e", u"ë": u"e",
    u"í": u"i", u"ì": u"i", u"î": u"i", u"ï": u"i",
    u"ó": u"o", u"ò": u"o", u"õ": u"o", u"ô": u"o", u"ö": u"o",
    u"ú": u"u", u"ù": u"u", u"û": u"u", u"ü": u"u",
    u"ç": u"c", u"ñ": u"n",
}


def strip_accents(text):
    if HAS_UNICODEDATA:
        decomposed = unicodedata.normalize("NFKD", text)
        return u"".join(ch for ch in decomposed if not unicodedata.combining(ch))
    result = text
    for accented, plain in ACCENT_MAP.items():
        result = result.replace(accented, plain)
    return result


def normalize_layer_token(text):
    """'CENÁRIO 01' -&gt; 'cenario01'."""
    lowered = strip_accents(to_text(text)).lower()
    return u"".join(ch for ch in lowered if ch.isalnum())


def scene_token(scene_value):
    """Codigo de cena ('01') -&gt; token da layer ('cenario01')."""
    return normalize_layer_token(u"cenario" + to_text(scene_value))


# ---------------------------------------------------------------------------
# Explosao de blocos em meshes rastreaveis
# ---------------------------------------------------------------------------

def generate_short_unique_id(already_used_ids, character_count=8):
    while True:
        candidate = uuid.uuid4().hex[:character_count]
        if candidate not in already_used_ids:
            already_used_ids.add(candidate)
            return candidate


def collect_definition_geometry(instance_object, transform_to_world):
    resolved_geometry = []
    definition_objects = instance_object.InstanceDefinition.GetObjects()
    combined_transform = transform_to_world * instance_object.InstanceXform

    for definition_object in definition_objects:
        if isinstance(definition_object, Rhino.DocObjects.InstanceObject):
            resolved_geometry.extend(
                collect_definition_geometry(definition_object, combined_transform)
            )
        else:
            geometry_copy = definition_object.Geometry.Duplicate()
            geometry_copy.Transform(combined_transform)
            resolved_geometry.append(geometry_copy)

    return resolved_geometry


def geometry_to_mesh(geometry):
    if isinstance(geometry, rg.Mesh):
        return geometry

    if isinstance(geometry, rg.Brep):
        meshing_parameters = rg.MeshingParameters.Default
        brep_meshes = rg.Mesh.CreateFromBrep(geometry, meshing_parameters)
        if not brep_meshes:
            return None
        combined_mesh = rg.Mesh()
        for piece in brep_meshes:
            combined_mesh.Append(piece)
        return combined_mesh

    return None


def join_meshes_for_element(mesh_list):
    if not mesh_list:
        return []
    if len(mesh_list) == 1:
        return mesh_list
    try:
        joined_mesh = rg.Mesh()
        for piece in mesh_list:
            joined_mesh.Append(piece)
        if joined_mesh.Faces.Count == 0 or joined_mesh.Vertices.Count == 0:
            return mesh_list
        return [joined_mesh]
    except Exception:
        return mesh_list


def explode_block_instances(object_ids, document, diagnostic_messages, used_short_ids):
    """Retorna (meshes, names, ids) em listas planas, uma entrada por elemento
    (ou por peca, quando a uniao nao for possivel).

    used_short_ids vem de fora para que os nomes curtos continuem unicos
    entre cenas diferentes, ja que esta funcao roda uma vez por cena."""
    flat_meshes = []
    flat_names = []
    flat_ids = []

    for object_id in object_ids:
        try:
            rhino_object = document.Objects.Find(object_id)
            if rhino_object is None:
                diagnostic_messages.append(u"NAO ENCONTRADO no documento: " + to_text(object_id))
                continue

            instance_name = rhino_object.Attributes.Name
            if not instance_name:
                instance_name = u"Sem nome"

            if isinstance(rhino_object, Rhino.DocObjects.InstanceObject):
                world_space_geometry = collect_definition_geometry(
                    rhino_object, Rhino.Geometry.Transform.Identity
                )
                raw_meshes = []
                for geometry in world_space_geometry:
                    mesh = geometry_to_mesh(geometry)
                    if mesh:
                        raw_meshes.append(mesh)
                final_meshes = join_meshes_for_element(raw_meshes)
            else:
                mesh = geometry_to_mesh(rhino_object.Geometry)
                final_meshes = [mesh] if mesh else []

            short_id = generate_short_unique_id(used_short_ids)
            display_name = to_text(instance_name) + u" - " + to_text(short_id)
            element_id_text = to_text(rhino_object.Id)

            for mesh in final_meshes:
                flat_meshes.append(mesh)
                flat_names.append(display_name)
                flat_ids.append(element_id_text)

        except Exception:
            diagnostic_messages.append(
                u"ERRO no objeto " + to_text(object_id) + u":\n" + to_text(traceback.format_exc())
            )

    return flat_meshes, flat_names, flat_ids


def group_ids_by_layer(object_ids, document, diagnostic_messages):
    """Um unico varrimento do input: agrupa GUIDs pelo token da layer RAIZ."""
    grouped = {}
    for object_id in object_ids:
        rhino_object = document.Objects.Find(object_id)
        if rhino_object is None:
            diagnostic_messages.append(u"NAO ENCONTRADO no documento: " + to_text(object_id))
            continue
        layer = document.Layers[rhino_object.Attributes.LayerIndex]
        root_layer_name = to_text(layer.FullPath).split(u"::")[0]
        grouped.setdefault(normalize_layer_token(root_layer_name), []).append(object_id)
    return grouped


# ---------------------------------------------------------------------------
# Interseccao raio x meshes
# ---------------------------------------------------------------------------

def find_closest_hit(line, meshes, names, ids, boxes):
    """Testa a linha contra todas as meshes e retorna o ponto de interseccao
    mais proximo da origem da linha, junto com o nome/id do elemento.

    Descarta antes, por bounding box, as meshes que nem chegam perto do raio."""
    line_box = rg.BoundingBox(line.From, line.To)

    best_distance = None
    best_point = None
    best_name = None
    best_id = None

    for mesh_index in range(len(meshes)):
        mesh = meshes[mesh_index]
        if mesh is None:
            continue

        mesh_box = boxes[mesh_index]
        if mesh_box is not None:
            if not rg.BoundingBox.Intersection(mesh_box, line_box).IsValid:
                continue

        intersection_result = Intersection.MeshLine(mesh, line)
        if isinstance(intersection_result, tuple):
            points = intersection_result[0]
        else:
            points = intersection_result

        if not points:
            continue

        for point in points:
            distance = line.From.DistanceTo(point)
            if best_distance is None or distance &lt; best_distance:
                best_distance = distance
                best_point = point
                best_name = names[mesh_index]
                best_id = ids[mesh_index]

    return best_point, best_name, best_id


def find_nearest_vector_index(vector_list, forward):
    """Indice do vetor do star mais alinhado (maior dot product) com forward."""
    if not vector_list or forward is None:
        return -1

    unit_forward = rg.Vector3d(forward)
    unit_forward.Unitize()

    best_dot = -2.0
    best_index = -1
    for index, vector in enumerate(vector_list):
        unit_vector = rg.Vector3d(vector)
        unit_vector.Unitize()
        dot = unit_vector * unit_forward
        if dot &gt; best_dot:
            best_dot = dot
            best_index = index

    return best_index


# ---------------------------------------------------------------------------
# Persistencia por assento
# ---------------------------------------------------------------------------

def sanitize_filename_component(text):
    """Remove caracteres invalidos em nomes de arquivo e troca espacos por
    underscore, garantindo um nome de arquivo seguro em qualquer SO."""
    if not text:
        return u"sem_nome"
    invalid_characters = [u"'", u"&lt;", u"&gt;", u":", u'"', u"/", u"\\", u",", u"|", u"?", u"*", u"[", u"]"]
    cleaned = u"".join(ch for ch in to_text(text) if ch not in invalid_characters)
    cleaned = cleaned.strip().replace(u" ", u"_")
    return cleaned if cleaned else u"sem_nome"


def build_seat_json_path(output_folder, scene_name_value, seat_name_value):
    file_name = (
        sanitize_filename_component(scene_name_value)
        + u"_"
        + sanitize_filename_component(seat_name_value)
        + u".json"
    )
    return os.path.join(output_folder, file_name)


def unwrap_single_branch(value):
    """Protege contra seat_name (ou outro parametro) chegando como uma lista
    de 1 item (ex: ['01']) em vez do item puro ('01'), o que acontece quando a
    data tree upstream esta grafada e o input do componente esta em modo List.
    O ideal e corrigir a tree upstream (Flatten antes deste componente); isto
    e so uma rede de seguranca."""
    if isinstance(value, list) and len(value) == 1:
        return value[0]
    return value


def make_json_safe(value):
    """Converte recursivamente bytes para texto unicode antes de serializar."""
    if isinstance(value, dict):
        return dict((make_json_safe(k), make_json_safe(v)) for k, v in value.items())
    if isinstance(value, list):
        return [make_json_safe(item) for item in value]
    if isinstance(value, BYTES_TYPE):
        return to_text(value)
    return value


# ===========================================================================
# Execucao principal
# ===========================================================================

document = Rhino.RhinoDoc.ActiveDoc
diagnostic_messages = []

Meshes = []
Names = []
Ids = []
MeshScenes = []

JsonPaths = []
SeatNames = []
SceneNames = []
NearestIndexList = []
NearestPointList = []
NearestNameList = []
NearestIdList = []

# --- validacao das listas paralelas ---------------------------------------

record_count = len(origin_point) if origin_point else 0
lengths_match = (
    record_count &gt; 0
    and record_count == len(forward_vec)
    and record_count == len(seat_name)
    and record_count == len(scene_name)
)

if record_count == 0:
    diagnostic_messages.append(u"ERRO: origin_point vazio. Nada a processar.")
elif not lengths_match:
    diagnostic_messages.append(
        u"ERRO: origin_point (" + to_text(record_count)
        + u"), forward_vec (" + to_text(len(forward_vec))
        + u"), seat_name (" + to_text(len(seat_name))
        + u") e scene_name (" + to_text(len(scene_name))
        + u") precisam ter o mesmo tamanho. Ligue as quatro saidas do "
        u"componente anterior (out_pontos, out_vetores, out_assentos, "
        u"out_cenarios), todas achatadas."
    )

# --- lista unica de direcoes do star --------------------------------------
# As direcoes sao as mesmas para todos os assentos, entao sao lidas e
# preparadas UMA vez, fora dos loops.

star_vectors = list(vectors) if vectors else []

if lengths_match and not star_vectors:
    lengths_match = False
    diagnostic_messages.append(
        u"ERRO: vectors esta vazio. Ligue a saida 'Vectors' do Vector Star "
        u"(alimentado por um unico ponto 0,0,0) neste input, em modo List."
    )
elif lengths_match:
    diagnostic_messages.append(
        u"vectors: " + to_text(len(star_vectors))
        + u" direcoes, compartilhadas por todos os " + to_text(record_count) + u" assentos"
    )

# --- agrupamento por cena, preservando a posicao original de cada registro --

records_by_scene = {}
if lengths_match:
    for record_index in range(record_count):
        token = scene_token(unwrap_single_branch(scene_name[record_index]))
        records_by_scene.setdefault(token, []).append(record_index)

results = [None] * (record_count if lengths_match else 0)


# --- processamento pesado --------------------------------------------------

if run and lengths_match:
    start_time = time.time()
    diagnostic_messages.append(u"run=True: iniciando processamento pesado")

    if output_folder and not os.path.exists(output_folder):
        os.makedirs(output_folder)

    # Precomputo unico: direcoes ja escaladas por ray_length, e as componentes
    # XYZ que vao para o JSON. Antes isso era refeito para cada raio de cada
    # assento.
    scaled_directions = [vector * ray_length for vector in star_vectors]
    vector_components = [[vector.X, vector.Y, vector.Z] for vector in star_vectors]

    # As direcoes sao as mesmas para todos, entao o "nearest" so depende de
    # forward_vec - e ha poucas direcoes distintas (uma por fileira). Cachear
    # evita varrer a lista inteira de novo para cada assento.
    nearest_index_cache = {}

    ids_by_layer = group_ids_by_layer(block_instances or [], document, diagnostic_messages)
    diagnostic_messages.append(
        u"Layers encontradas no input: " + u", ".join(sorted(ids_by_layer.keys()))
    )

    used_short_ids = set()

    for token in sorted(records_by_scene.keys()):
        scene_object_ids = ids_by_layer.get(token, [])
        if not scene_object_ids:
            diagnostic_messages.append(
                u"AVISO: nenhum objeto na layer '" + token
                + u"'. Todos os raios dessa cena vao resultar em miss."
            )

        scene_meshes, scene_names, scene_ids = explode_block_instances(
            scene_object_ids, document, diagnostic_messages, used_short_ids
        )
        scene_boxes = [m.GetBoundingBox(True) if m is not None else None for m in scene_meshes]

        diagnostic_messages.append(
            u"Cena '" + token + u"': " + to_text(len(scene_meshes)) + u" elementos explodidos"
        )

        Meshes.extend(scene_meshes)
        Names.extend(scene_names)
        Ids.extend(scene_ids)
        MeshScenes.extend([token] * len(scene_meshes))

        for record_index in records_by_scene[token]:
            seat_origin = origin_point[record_index]
            seat_forward = forward_vec[record_index]
            name = unwrap_single_branch(seat_name[record_index])
            scene_value = unwrap_single_branch(scene_name[record_index])

            if seat_origin is None or seat_forward is None:
                results[record_index] = (None, name, scene_value, -1, None, None, None)
                diagnostic_messages.append(
                    u"PULADO (dados faltando): cena '" + to_text(scene_value)
                    + u"' / assento '" + to_text(name) + u"'"
                )
                continue

            rays_data = []
            for ray_index in range(len(scaled_directions)):
                line = rg.Line(seat_origin, seat_origin + scaled_directions[ray_index])
                hit_point, hit_name, hit_id = find_closest_hit(
                    line, scene_meshes, scene_names, scene_ids, scene_boxes
                )
                rays_data.append({
                    "index": ray_index,
                    "vector": vector_components[ray_index],
                    "hit": hit_point is not None,
                    "point": [hit_point.X, hit_point.Y, hit_point.Z] if hit_point else None,
                    "name": hit_name,
                    "id": hit_id,
                })

            forward_key = (
                round(seat_forward.X, 6),
                round(seat_forward.Y, 6),
                round(seat_forward.Z, 6),
            )
            if forward_key not in nearest_index_cache:
                nearest_index_cache[forward_key] = find_nearest_vector_index(
                    star_vectors, seat_forward
                )
            nearest_index = nearest_index_cache[forward_key]

            nearest_point = None
            nearest_name = None
            nearest_id = None
            if nearest_index &gt;= 0:
                nearest_ray = rays_data[nearest_index]
                if nearest_ray["hit"]:
                    nearest_point = nearest_ray["point"]
                nearest_name = nearest_ray["name"]
                nearest_id = nearest_ray["id"]

            seat_result = {
                "scene_name": scene_value,
                "scene_layer_token": token,
                "seat_name": name,
                "origin": [seat_origin.X, seat_origin.Y, seat_origin.Z],
                "forward_vector": [seat_forward.X, seat_forward.Y, seat_forward.Z],
                "ray_length": ray_length,
                "rays": rays_data,
                "nearest_index": nearest_index,
                "nearest_point": nearest_point,
                "nearest_name": nearest_name,
                "nearest_id": nearest_id,
            }

            seat_json_path = None
            if output_folder:
                seat_json_path = build_seat_json_path(output_folder, scene_value, name)
                safe_seat_result = make_json_safe(seat_result)
                with io.open(seat_json_path, "w", encoding="utf-8") as json_file:
                    json.dump(safe_seat_result, json_file, separators=(",", ":"), ensure_ascii=False)

            results[record_index] = (
                seat_json_path, name, scene_value,
                nearest_index, nearest_point, nearest_name, nearest_id,
            )

            hit_count = sum(1 for ray in rays_data if ray["hit"])
            diagnostic_messages.append(
                u"Cena '" + to_text(scene_value) + u"' / assento '" + to_text(name) + u"': "
                + to_text(len(rays_data)) + u" raios, " + to_text(hit_count)
                + u" hits, nearest_index=" + to_text(nearest_index)
                + (u", JSON salvo" if seat_json_path else u", JSON nao salvo (output_folder vazio)")
            )

    elapsed_seconds = time.time() - start_time
    diagnostic_messages.append(
        u"Tempo total de processamento: " + to_text(round(elapsed_seconds, 2)) + u"s"
    )


# --- carregamento dos JSONs existentes -------------------------------------

elif not run and lengths_match:
    diagnostic_messages.append(u"run=False: tentando carregar JSONs existentes por assento")

    for record_index in range(record_count):
        name = unwrap_single_branch(seat_name[record_index])
        scene_value = unwrap_single_branch(scene_name[record_index])

        seat_json_path = None
        if output_folder:
            seat_json_path = build_seat_json_path(output_folder, scene_value, name)

        if seat_json_path and os.path.exists(seat_json_path):
            with io.open(seat_json_path, "r", encoding="utf-8") as json_file:
                seat_result = json.load(json_file)

            results[record_index] = (
                seat_json_path, name, scene_value,
                seat_result.get("nearest_index", -1),
                seat_result.get("nearest_point"),
                seat_result.get("nearest_name"),
                seat_result.get("nearest_id"),
            )
            diagnostic_messages.append(
                u"Cena '" + to_text(scene_value) + u"' / assento '" + to_text(name)
                + u"': JSON carregado de " + to_text(seat_json_path)
            )
        else:
            results[record_index] = (seat_json_path, name, scene_value, -1, None, None, None)
            diagnostic_messages.append(
                u"Cena '" + to_text(scene_value) + u"' / assento '" + to_text(name)
                + u"': nenhum JSON encontrado em " + to_text(seat_json_path)
            )


# --- desempacota na ordem original dos registros ---------------------------

for entry in results:
    if entry is None:
        continue

    path, name, scene_value, nearest_index, nearest_point, nearest_name, nearest_id = entry

    JsonPaths.append(path)
    SeatNames.append(name)
    SceneNames.append(scene_value)
    NearestIndexList.append(nearest_index)
    NearestPointList.append(
        rg.Point3d(nearest_point[0], nearest_point[1], nearest_point[2])
        if nearest_point else None
    )
    NearestNameList.append(nearest_name)
    NearestIdList.append(nearest_id)

