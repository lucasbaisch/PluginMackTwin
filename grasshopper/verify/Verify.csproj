<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- The component targets Rhino 7 = C# 7.3. Pinning the language version here is what
         proves the deliverable does not accidentally use a newer language feature. -->
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>GazeSimulatorVerify</AssemblyName>
    <RootNamespace>GazeSimulatorVerify</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RhinoStubs.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Generated\SimulationCore.g.cs" />
  </ItemGroup>

</Project>
