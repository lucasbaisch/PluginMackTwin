<Window x:Class="PluginCAISM.Interface.JanelaDeSelecaoDeCenarios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerar Vista 3D — Selecionar Cenários"
        Height="520" Width="560"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="#F4F6F8"
        FontFamily="Segoe UI">

    <!-- A janela é autônoma quanto a recursos: os pincéis e estilos da JanelaPluginCAISM vivem
         no Window.Resources dela e não alcançam outra janela. Os valores abaixo repetem a mesma
         paleta de propósito, para que o diálogo não destoe da tela que o abriu. -->
    <Window.Resources>
        <SolidColorBrush x:Key="BrushBd"   Color="#E4E7EC"/>
        <SolidColorBrush x:Key="BrushTx"   Color="#1B2230"/>
        <SolidColorBrush x:Key="BrushTx2"  Color="#4B5563"/>
        <SolidColorBrush x:Key="BrushTx3"  Color="#7A8392"/>

        <LinearGradientBrush x:Key="BrushPrimaryGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0E6B6B" Offset="0"/>
            <GradientStop Color="#0A5757" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="EstiloBotaoPrincipal" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="22,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource BrushPrimaryGradient}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#D6DAE0"/>
                                <Setter Property="Foreground" Value="#A0A8B8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EstiloBotaoSecundario" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushTx2}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="White"
                                BorderBrush="{StaticResource BrushBd}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- instrução -->
            <RowDefinition Height="*"/>      <!-- lista rolável -->
            <RowDefinition Height="Auto"/>   <!-- contador -->
            <RowDefinition Height="Auto"/>   <!-- botões -->
        </Grid.RowDefinitions>

        <!-- ── Instrução ──────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14,12"
                BorderBrush="{StaticResource BrushBd}" BorderThickness="1" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Marque os Cenários deste arquivo Revit"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTx}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                           Foreground="{StaticResource BrushTx2}">
                    Cada cenário é um <Run FontWeight="SemiBold">arquivo Revit separado</Run>.
                    Marque apenas os cenários correspondentes ao modelo aberto agora.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,8,0,0"
                           Foreground="{StaticResource BrushTx2}">
                    Marque os <Run FontWeight="SemiBold">dois períodos</Run> do mesmo cenário — o do
                    <Run FontWeight="SemiBold">DIA</Run> e o da
                    <Run FontWeight="SemiBold">NOITE</Run>. Cada um vira uma vista 3D, com todos os
                    hitpoints de todos os participantes e assentos daquele cenário.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── Lista rolável de cenários ──────────────────────────────── -->
        <Border Grid.Row="1" Background="White" CornerRadius="8"
                BorderBrush="{StaticResource BrushBd}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                <ItemsControl x:Name="ListaDeCenarios">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Nome}"
                                      IsChecked="{Binding Marcado, Mode=TwoWay}"
                                      IsEnabled="{Binding PodeMarcar}"
                                      FontSize="12.5"
                                      Foreground="{StaticResource BrushTx}"
                                      Margin="0,5" Padding="6,0,0,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ── Contador ───────────────────────────────────────────────── -->
        <TextBlock x:Name="TextoDoContador" Grid.Row="2" Margin="2,10,0,0"
                   FontSize="11.5" Foreground="{StaticResource BrushTx3}"/>

        <!-- ── Botões ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <!-- IsCancel já fecha a janela com DialogResult=false e dá o atalho Esc. Um Click
                 handler aqui além disso tentaria definir DialogResult numa janela já fechada. -->
            <Button x:Name="BotaoCancelar" Content="Cancelar" IsCancel="True"
                    Style="{StaticResource EstiloBotaoSecundario}" Margin="0,0,10,0"/>
            <Button x:Name="BotaoOk" Content="OK" IsDefault="True"
                    Style="{StaticResource EstiloBotaoPrincipal}"
                    Click="BotaoOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
