<Window x:Class="PluginCAISM.Interface.JanelaPluginCAISM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plugin CAISM — Análise de Estresse em Realidade Virtual"
        Height="840" Width="1200"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ── Brushes ─────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BrushBgWindow"   Color="#F4F6F8"/>
        <SolidColorBrush x:Key="BrushBgSurface"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushBgSubtle"   Color="#F8FAFB"/>
        <SolidColorBrush x:Key="BrushBd"         Color="#E4E7EC"/>
        <SolidColorBrush x:Key="BrushBdSoft"     Color="#EEF0F3"/>
        <SolidColorBrush x:Key="BrushTx"         Color="#1B2230"/>
        <SolidColorBrush x:Key="BrushTx2"        Color="#4B5563"/>
        <SolidColorBrush x:Key="BrushTx3"        Color="#7A8392"/>
        <SolidColorBrush x:Key="BrushTxMute"     Color="#9AA3B2"/>
        <SolidColorBrush x:Key="BrushAccent"     Color="#0E6B6B"/>
        <SolidColorBrush x:Key="BrushAccentSoft" Color="#E6F1F1"/>
        <SolidColorBrush x:Key="BrushAccentDark" Color="#0A5757"/>
        <SolidColorBrush x:Key="BrushOk"         Color="#0A5757"/>
        <SolidColorBrush x:Key="BrushOkSoft"     Color="#E6F4EC"/>
        <SolidColorBrush x:Key="BrushCortisolBg" Color="#F1ECF6"/>
        <SolidColorBrush x:Key="BrushCortisolFg" Color="#7A4FD9"/>
        <SolidColorBrush x:Key="BrushSensorBg"   Color="#FFF3E6"/>
        <SolidColorBrush x:Key="BrushSensorFg"   Color="#D9871F"/>
        <SolidColorBrush x:Key="BrushFormularioBg" Color="#E8EEF9"/>
        <SolidColorBrush x:Key="BrushFormularioFg" Color="#2F6BD9"/>

        <LinearGradientBrush x:Key="BrushPrimaryGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0E6B6B" Offset="0"/>
            <GradientStop Color="#0A5757" Offset="1"/>
        </LinearGradientBrush>

        <!-- ── Button: Primary (Gerar Vista Revit 3D) ─────────────────── -->
        <Style x:Key="EstiloBotaoPrincipal" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource BrushPrimaryGradient}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#D6DAE0"/>
                                <Setter Property="Foreground" Value="#A0A8B8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Button: Secondary (Exportar CSV) ───────────────────────── -->
        <Style x:Key="EstiloBotaoSecundario" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTx2}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BrushBd}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Button: Green (toggle "Voltar à tabela") ───────────────── -->
        <Style x:Key="EstiloBotaoVerde" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushOk}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Button: Load (in data-loader cards) ────────────────────── -->
        <Style x:Key="EstiloBotaoCarregamento" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TabControl ─────────────────────────────────────────────── -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BrushBgWindow}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="White"
                                    BorderBrush="{StaticResource BrushBd}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True"
                                          HorizontalAlignment="Left"
                                          Margin="20,0,0,0"
                                          Background="Transparent"/>
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTx3}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="14,11,14,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Margin="0,0,2,-1">
                            <ContentPresenter ContentSource="Header"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTx}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F4F6F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox ───────────────────────────────────────────────── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBd}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTx}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <!-- ── DataGrid ───────────────────────────────────────────────── -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BrushBgSubtle}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTx3}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBd}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTx}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF2F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="12,6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BrushBdSoft}"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF2F7"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTx}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── DataGrid column text styles ────────────────────────────── -->
        <Style x:Key="ColunaTexto" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTx}"/>
        </Style>

        <!-- Igual a ColunaTexto, mas deixa o texto quebrar em várias linhas e alinha ao topo.
             Usada na coluna VALOR da tabela de formulários, cuja linha "Objetos mais observados"
             traz cinco itens, um por linha. Nas demais linhas, de valor curto, não muda nada. -->
        <Style x:Key="ColunaTextoComQuebra" TargetType="TextBlock" BasedOn="{StaticResource ColunaTexto}">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <Style x:Key="ColunaNumero" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTx2}"/>
        </Style>

        <!-- ══ Aba "Dados do Participante" ═══════════════════════════════

             A aba trocou a tabela plana de questão/resposta por cartões de destaque e blocos
             recolhíveis. Os enunciados completos das planilhas viravam 33 linhas de texto corrido
             em que a resposta — o que interessa — ficava encoberta pela pergunta; o de-para em
             Configuracao.DeParaDeQuestoes reduz cada enunciado ao substantivo que ele mede e
             indica em que bloco ele entra. O enunciado original continua acessível como tooltip.
        -->

        <BooleanToVisibilityConverter x:Key="ConversorDeBooleanoParaVisibilidade"/>

        <!-- ── Cartão de destaque do participante ─────────────────────── -->
        <DataTemplate x:Key="ModeloDeCartaoDeDestaque">
            <Border Background="White" CornerRadius="8" Padding="12,10"
                    BorderBrush="{StaticResource BrushBd}" BorderThickness="1"
                    Margin="0,0,10,10" MinWidth="150">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Path Data="{Binding Icone}" Fill="{StaticResource BrushAccent}"
                              Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Rotulo}" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTx3}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Valor}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTx}" TextTrimming="CharacterEllipsis"
                               MaxWidth="220" ToolTip="{Binding Valor}"/>

                    <Border CornerRadius="4" Padding="6,2" Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            Background="{Binding FundoDoQualificador}"
                            Visibility="{Binding TemQualificador,
                                         Converter={StaticResource ConversorDeBooleanoParaVisibilidade}}">
                        <TextBlock Text="{Binding Qualificador}" FontSize="10.5"
                                   FontWeight="SemiBold" Foreground="{Binding CorDoQualificador}"/>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ── Uma linha rótulo/valor dentro de um grupo ──────────────── -->
        <DataTemplate x:Key="ModeloDeLinhaDeFormulario">
            <Border BorderBrush="{StaticResource BrushBdSoft}" BorderThickness="0,0,0,1"
                    Padding="0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- SharedSizeGroup mantém os rótulos alinhados entre todos os grupos -->
                        <ColumnDefinition Width="Auto" MinWidth="180"
                                          SharedSizeGroup="RotuloDoItem"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Item}" FontSize="11.5"
                               Foreground="{StaticResource BrushTx2}" TextWrapping="Wrap"
                               Margin="0,0,16,0" VerticalAlignment="Top"
                               ToolTip="{Binding EnunciadoOriginal}"/>

                    <TextBlock Grid.Column="1" Text="{Binding Valor}" FontSize="11.5"
                               FontWeight="SemiBold" Foreground="{StaticResource BrushTx}"
                               TextWrapping="Wrap" VerticalAlignment="Top"/>

                    <TextBlock Grid.Column="2" Text="{Binding ValorComplementar}" FontSize="11.5"
                               Foreground="{StaticResource BrushTx2}" TextWrapping="Wrap"
                               VerticalAlignment="Top" Width="220" Margin="16,0,0,0"
                               Visibility="{Binding DataContext.MostrarSegundoValor,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl},
                                            Converter={StaticResource ConversorDeBooleanoParaVisibilidade}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── Bloco de um grupo temático ─────────────────────────────────
             Sem Expander: todos os grupos ficam sempre abertos. O cabeçalho continua idêntico —
             ícone, título, complemento e contagem —, mas deixa de ser clicável, e o conteúdo
             deixa de ter estado de aberto/fechado. -->
        <DataTemplate x:Key="ModeloDeGrupoDeFormulario">
            <Border Background="White" CornerRadius="8" Margin="0,0,0,10"
                    BorderBrush="{StaticResource BrushBd}" BorderThickness="1">
                <StackPanel>
                    <!-- Título, complemento e contagem correm em linha, como antes. -->
                    <StackPanel Orientation="Horizontal" Margin="14,9,8,9">
                        <Border Width="26" Height="26" CornerRadius="7"
                                Background="{StaticResource BrushAccentSoft}" Margin="0,0,10,0">
                            <Path Data="{Binding Icone}" Fill="{StaticResource BrushAccent}"
                                  Width="15" Height="15" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="{Binding Titulo}" FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTx}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding Complemento}" FontSize="11.5"
                                   Foreground="{StaticResource BrushTx3}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding TemComplemento,
                                                Converter={StaticResource ConversorDeBooleanoParaVisibilidade}}"/>

                        <TextBlock Text="{Binding Contagem}" FontSize="10.5"
                                   Foreground="{StaticResource BrushTxMute}"
                                   Margin="12,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- O que o domínio mede. Só os cinco domínios do IEEE têm descrição; nos
                         demais grupos a linha não é desenhada. -->
                    <TextBlock Text="{Binding Descricao}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTx3}"
                               Margin="46,0,14,10"
                               Visibility="{Binding TemDescricao,
                                            Converter={StaticResource ConversorDeBooleanoParaVisibilidade}}"/>

                    <StackPanel Margin="46,0,14,10">
                        <!-- Cabeçalho das colunas de valor. Só os sintomas o usam: é onde ficam
                             "FREQUÊNCIA" e "É DO TRABALHO?", que antes se repetiam em cada uma
                             das catorze linhas. -->
                        <Grid Margin="0,0,0,4"
                              Visibility="{Binding MostrarCabecalhoDeColunas,
                                           Converter={StaticResource ConversorDeBooleanoParaVisibilidade}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="180"
                                                  SharedSizeGroup="RotuloDoItem"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{Binding CabecalhoDeValor}"
                                       FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTx3}"/>
                            <TextBlock Grid.Column="2" Text="{Binding CabecalhoDeComplemento}"
                                       FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTx3}"
                                       Width="220" Margin="16,0,0,0"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Itens}"
                                      ItemTemplate="{StaticResource ModeloDeLinhaDeFormulario}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ── Rótulo "Filtros" das barras de filtro ───────────────────────
             Definido uma vez e usado nas três abas de análise, para que o ícone e o texto sejam
             literalmente os mesmos. Um ContentControl sem conteúdo próprio: todo o visual vem do
             template. -->
        <Style x:Key="EstiloRotuloDeFiltro" TargetType="ContentControl">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M3 5h18l-7 9v6l-4-2v-4Z"
                                  Stroke="#7A8392" StrokeThickness="1.5" Fill="Transparent"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Filtros" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTx2}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Variantes SEM Foreground, para a tabela de objetos por Potencial Homeodinâmico.
             Um Foreground fixo aqui venceria o da DataGridRow e anularia a cor da classificação;
             omitindo-o, o texto herda a cor definida pelo gatilho da linha. As outras tabelas
             continuam usando ColunaTexto/ColunaNumero. -->
        <Style x:Key="ColunaTextoHerdandoCor" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style x:Key="ColunaNumeroHerdandoCor" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <!-- ── Ponto colorido das legendas ─────────────────────────────── -->
        <Style x:Key="EstiloLegendaDot" TargetType="Border">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <!-- ── Shared icon box style ───────────────────────────────────── -->
        <Style x:Key="EstiloIconBox" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

    </Window.Resources>

    <DockPanel Background="{StaticResource BrushBgWindow}">

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- FOOTER                                                        -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="RodapeAcoes"
                DockPanel.Dock="Bottom"
                Background="White"
                BorderBrush="{StaticResource BrushBd}"
                BorderThickness="0,1,0,0"
                Padding="20,12"
                Visibility="Collapsed">
            <DockPanel>
                <!-- Left: spinner -->
                <TextBlock x:Name="TextoSpinner"
                           Text="Processando..."
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Visibility="Collapsed"
                           FontStyle="Italic"
                           Foreground="{StaticResource BrushTx3}"/>

                <!-- Right: action buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!-- Auditoria da sessão: alterna, DENTRO da aba de Potencial Homeodinâmico,
                         entre a tabela de objetos e a tabela de eventos detectados. Fica no rodapé,
                         à esquerda de "Recarregar Arquivos", e some nas outras abas — o painel que
                         ele alterna pertence só a esta. Visibilidade controlada por
                         AtualizarVisibilidadeDoBotaoDeAuditoria. -->
                    <Button x:Name="BotaoAuditoria"
                            Style="{StaticResource EstiloBotaoSecundario}"
                            Margin="0,0,10,0"
                            Content="Eventos Detectados (auditoria)"
                            Click="AlternarAuditoria"/>
                    <Button x:Name="BotaoRecarregarArquivos"
                            Style="{StaticResource EstiloBotaoSecundario}"
                            Margin="0,0,20,0"
                            Click="RecarregarArquivos_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M4 12a8 8 0 0 1 13.7-5.7L20 8 M20 4v4h-4 M20 12a8 8 0 0 1-13.7 5.7L4 16 M4 20v-4h4"
                                      Stroke="#4B5563" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Recarregar Arquivos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <!-- "Gerar Vista Revit 3D" saiu daqui: a ação depende do cenário selecionado, que
                         é filtro da aba de Potencial Homeodinâmico. Ficava no cabeçalho comum, visível
                         nas três abas, onde o cenário que ela usaria não estava à vista. -->
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- VIEWS — navegação por visibilidade (sem abas)                 -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Grid>

            <!-- ── VIEW 1: Instruções / Carregamento de dados ─────────── -->
            <ScrollViewer x:Name="PainelInstrucoes"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,28" MaxWidth="1100">

                        <!-- Title area -->
                        <TextBlock Text="PLUG-IN DE POTENCIAL HOMEODINÂMICO"
                                   FontSize="22" FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTx}"
                                   Margin="0,0,0,10"/>
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="13.5"
                                   Foreground="{StaticResource BrushTx2}"
                                   LineHeight="21"
                                   MaxWidth="760"
                                   Margin="0,0,0,10" HorizontalAlignment="Left">
                            Pesquisa desenvolvida em nível de Doutorado por Lucas Figueiredo Baisch sob
                            orientação da Professora Doutora Rachel Zuanon Dias no Programa de
                            Pós-Graduação em Arquitetura, Tecnologia e Cidade da Faculdade de Engenharia
                            Civil, Arquitetura e Urbanismo da Universidade Estadual de Campinas.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="13.5"
                                   Foreground="{StaticResource BrushTx2}"
                                   LineHeight="21"
                                   MaxWidth="760"
                                   Margin="0,0,0,22" HorizontalAlignment="Left">
                            O objetivo deste artefato é correlacionar e visualizar as respostas
                            neuropsicofisiológicas dos profissionais de enfermagem atuantes no Hospital da
                            Mulher Prof. Dr. José Aristodemo Pinotti (CAISM/Unicamp). Carregue as quatro
                            fontes de dados abaixo e clique em <Bold>Avançar</Bold> para a visualização e
                            análise dos dados.
                        </TextBlock>

                        <!-- Step cards (4-column grid) -->
                        <UniformGrid Columns="4" Margin="0,0,0,22">

                            <!-- Step 1: Sessões -->
                            <Border Margin="0,0,7,0"
                                    Background="White" BorderBrush="{StaticResource BrushBd}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="16,16,16,14">
                                <DockPanel>
                                    <!-- Grupo de carregamento: sempre fixado no rodapé do card -->
                                    <StackPanel DockPanel.Dock="Bottom">
                                        <Button x:Name="BotaoCarregarSessoes"
                                                Content="Carregar Dados das Sessões"
                                                Style="{StaticResource EstiloBotaoCarregamento}"
                                                Click="BotaoCarregarSessoes_Click"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,14,0,0"/>
                                        <TextBlock x:Name="TextoStatusSessoes"
                                                   Text="Nenhum arquivo CSV carregado"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTx3}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Conteúdo descritivo (preenche o topo) -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="36" Height="36" CornerRadius="8"
                                                    Background="{StaticResource BrushAccentSoft}"
                                                    Margin="0,0,10,0">
                                                <Path Data="M1.5 12 C4 6 8.5 4.5 12 4.5 C15.5 4.5 20 6 22.5 12 C20 18 15.5 19.5 12 19.5 C8.5 19.5 4 18 1.5 12 Z M12 8.5 a3.5 3.5 0 1 0 0.001 0"
                                                      Stroke="#0E6B6B" StrokeThickness="1.5" Fill="Transparent"
                                                      Width="16" Height="16" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="ETAPA 1 · .CSV"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTx3}"/>
                                                <TextBlock Text="Dados das Sessões"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTx}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{StaticResource BrushTx2}" LineHeight="18">
                                            Rastreamento ocular frame a frame coletado durante sessões de Realidade Virtual
                                            pelo dispositivo Head Mounted Display.
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Step 2: Sensores -->
                            <Border Margin="7,0"
                                    Background="White" BorderBrush="{StaticResource BrushBd}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="16,16,16,14">
                                <DockPanel>
                                    <!-- Grupo de carregamento: sempre fixado no rodapé do card -->
                                    <StackPanel DockPanel.Dock="Bottom">
                                        <Button x:Name="BotaoCarregarSensores"
                                                Content="Carregar Dados dos Sensores"
                                                Style="{StaticResource EstiloBotaoCarregamento}"
                                                Click="BotaoCarregarSensores_Click"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,14,0,0"/>
                                        <TextBlock x:Name="TextoStatusSensores"
                                                   Text="Nenhum arquivo XLSX carregado"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTx3}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Conteúdo descritivo (preenche o topo) -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="36" Height="36" CornerRadius="8"
                                                    Background="{StaticResource BrushSensorBg}"
                                                    Margin="0,0,10,0">
                                                <Path Data="M8.5 8.5 A5 5 0 0 0 8.5 15.5 M15.5 8.5 A5 5 0 0 1 15.5 15.5 M5.5 5.5 A9 9 0 0 0 5.5 18.5 M18.5 5.5 A9 9 0 0 1 18.5 18.5"
                                                      Stroke="#D9871F" StrokeThickness="1.5" Fill="Transparent"
                                                      Width="16" Height="16" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="ETAPA 2 · .XLSX"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTx3}"/>
                                                <TextBlock Text="Dados dos Sensores"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTx}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{StaticResource BrushTx2}" LineHeight="18">
                                            Contexto (temperatura do ambiente, umidade relativa, nível de ruído e
                                            presença de monóxido de carbono) da Sala do Experimento.
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Step 3: Cortisol -->
                            <Border Margin="7,0"
                                    Background="White" BorderBrush="{StaticResource BrushBd}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="16,16,16,14">
                                <DockPanel>
                                    <!-- Grupo de carregamento: sempre fixado no rodapé do card -->
                                    <StackPanel DockPanel.Dock="Bottom">
                                        <Button x:Name="BotaoCarregarCortisol"
                                                Content="Carregar Dados de Cortisol"
                                                Style="{StaticResource EstiloBotaoCarregamento}"
                                                Click="BotaoCarregarCortisol_Click"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,14,0,0"/>
                                        <TextBlock x:Name="TextoStatusCortisol"
                                                   Text="Nenhum arquivo XLSX carregado"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTx3}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Conteúdo descritivo (preenche o topo) -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="36" Height="36" CornerRadius="8"
                                                    Background="{StaticResource BrushCortisolBg}"
                                                    Margin="0,0,10,0">
                                                <Path Data="M12 3 C12 3 18 9.5 18 14 C18 17.3 15.3 20 12 20 C8.7 20 6 17.3 6 14 C6 9.5 12 3 12 3 Z M9 14 C9 14 9.5 16.5 12 17"
                                                      Stroke="#7A4FD9" StrokeThickness="1.5" Fill="Transparent"
                                                      Width="16" Height="16" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="ETAPA 3 · .XLSX"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTx3}"/>
                                                <TextBlock Text="Dados de Cortisol"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTx}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{StaticResource BrushTx2}" LineHeight="18">
                                            Indicadores de cortisol salivar por participante da pesquisa.
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Step 4: Formulários -->
                            <Border Margin="7,0,0,0"
                                    Background="White" BorderBrush="{StaticResource BrushBd}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="16,16,16,14">
                                <DockPanel>
                                    <!-- Grupo de carregamento: sempre fixado no rodapé do card -->
                                    <StackPanel DockPanel.Dock="Bottom">
                                        <Button x:Name="BotaoCarregarFormularios"
                                                Content="Carregar Formulários"
                                                Style="{StaticResource EstiloBotaoCarregamento}"
                                                Click="BotaoCarregarFormularios_Click"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,14,0,0"/>
                                        <TextBlock x:Name="TextoStatusFormularios"
                                                   Text="Nenhum arquivo XLSX carregado"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTx3}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Conteúdo descritivo (preenche o topo) -->
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="36" Height="36" CornerRadius="8"
                                                    Background="{StaticResource BrushFormularioBg}"
                                                    Margin="0,0,10,0">
                                                <Path Data="M7 3 h7 l4 4 v14 a1 1 0 0 1 -1 1 H7 a1 1 0 0 1 -1 -1 V4 a1 1 0 0 1 1 -1 Z M14 3 v4 h4 M9 12 h6 M9 16 h6"
                                                      Stroke="#2F6BD9" StrokeThickness="1.5" Fill="Transparent"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Width="16" Height="16" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="ETAPA 4 · .XLSX"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTx3}"/>
                                                <TextBlock Text="Formulários"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTx}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{StaticResource BrushTx2}" LineHeight="18">
                                            Respostas dos formulários aplicados aos participantes.
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Avançar: vai para a tela de Análise do Grupo -->
                        <Button x:Name="BotaoAvancar"
                                Style="{StaticResource EstiloBotaoPrincipal}"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,22"
                                Click="Avancar_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Avançar" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <Path Data="M5 12h14 M13 6l6 6-6 6"
                                          Stroke="White" StrokeThickness="1.7" Fill="Transparent"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="14" Height="14" Stretch="Uniform"
                                          VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- Logos institucionais (rodapé da tela de instruções) -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,28,0,0">
                            <Image Source="pack://application:,,,/PluginCAISM;component/Assets/logo unicamp.png" Height="75"
                                   Stretch="Uniform" Margin="14,0" />
                            <Image Source="pack://application:,,,/PluginCAISM;component/Assets/logo fecfau.png" Height="75"
                                   Stretch="Uniform" Margin="14,0" />
                            <Image Source="pack://application:,,,/PluginCAISM;component/Assets/logo dasmind.png" Height="75"
                                   Stretch="Uniform" Margin="14,0" />
                            <Image Source="pack://application:,,,/PluginCAISM;component/Assets/logo caism.png" Height="75"
                                   Stretch="Uniform" Margin="14,0" />
                            <Image Source="pack://application:,,,/PluginCAISM;component/Assets/logo labeest.png" Height="75"
                                   Stretch="Uniform" Margin="14,0" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

            <!-- ── VIEW 2: Análise do Grupo ───────────────────────────── -->
            <DockPanel x:Name="PainelAnalise" Visibility="Collapsed">

              <!-- Aba de operação (existente) e aba de contextualização (§5.5.1).
                   A barra de filtros pertence à aba de operação: os filtros de cenário/evento/
                   pupila não se aplicam à contextualização, que é por participante. -->
              <TabControl x:Name="AbasDeAnalise" SelectionChanged="AbaDeAnaliseAlterada">
                <!-- §5.5.1 — único filtro é o cenário; conteúdo principal é a tabela de objetos -->
                <TabItem x:Name="AbaDePotencialHomeodinamico" Header="Potencial Homeodinâmico">
                  <DockPanel>

                    <!-- Filter bar -->
                    <Border DockPanel.Dock="Top"
                            Background="White"
                            BorderBrush="{StaticResource BrushBd}"
                            BorderThickness="0,0,0,1"
                            Padding="20,12">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <ContentControl Style="{StaticResource EstiloRotuloDeFiltro}"/>

                            <!-- Cenário = ambiente VR + período do dia (Sessao.RotuloDeCenario),
                                 o mesmo recorte de um arquivo Revit. Alimenta a cascata: escolher
                                 um cenário reduz a lista de Sessões às daquele cenário. -->
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="CENÁRIO" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTx3}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="FiltroCenario" Width="220" IsEnabled="False"
                                          SelectionChanged="CenarioAlterado"/>
                            </StackPanel>
                            <!-- Sessões do cenário selecionado: um item por participante × assento
                                 × período (Sessao.RotuloDeSessao). "Todas as Sessões" é a primeira
                                 opção e não restringe o eixo. -->
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="SESSÕES" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTx3}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SeletorDeSessao" Width="200" IsEnabled="False"
                                          SelectionChanged="FiltroAlterado"/>
                            </StackPanel>
                            <!-- O filtro de PARTICIPANTE foi REMOVIDO. Restam Cenário e Sessões. -->

                            <!-- Os dois botões ficam ao lado dos filtros porque agem sobre o que os
                                 filtros produzem: a exportação leva a tabela como está na tela, e a
                                 vista Revit leva o cenário selecionado. -->
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Bottom">
                                <Button x:Name="BotaoExportarTabela"
                                        Style="{StaticResource EstiloBotaoSecundario}"
                                        IsEnabled="False"
                                        ToolTip="Exporta o relatório em PDF, com cabeçalho de identificação da pesquisa"
                                        Click="BotaoExportarTabela_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M12 3v12 M7 10l5 5 5-5 M4 19h16"
                                                  Stroke="#4B5563" StrokeThickness="1.6" Fill="Transparent"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Exportar Relatório" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Bottom">
                                <Button x:Name="BotaoGerarVistaRevit"
                                        Style="{StaticResource EstiloBotaoPrincipal}"
                                        IsEnabled="False"
                                        Click="BotaoGerarVistaRevit_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="m12 3 9 5v8l-9 5-9-5V8Z M3 8l9 5 9-5 M12 13v10"
                                                  Stroke="White" StrokeThickness="1.6" Fill="Transparent"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="Gerar Vista Revit 3D" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </StackPanel>

                        </WrapPanel>
                    </Border>

                    <!-- A tabela de objetos e a tabela de auditoria ocupam a MESMA área, alternadas
                         pelo botão "Eventos Detectados (auditoria)" do rodapé. -->
                    <Grid>

                        <!-- LastChildFill (padrão) faz a tabela esticar até o fim da aba. -->
                        <DockPanel x:Name="PainelGraficos" Margin="20,12,20,14">

                            <!-- Tabela de objetos por Potencial Homeodinâmico (§5.5.1):
                                 um objeto por linha, texto verde/vermelho/cinza conforme o
                                 Quadro 41. -->
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <!-- Legenda de classificação PH. As cores vêm de
                                         Configuracao.CoresDeClassificacaoDePotencial, registradas
                                         como recursos no construtor da janela. -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border Style="{StaticResource EstiloLegendaDot}"
                                                    Background="{DynamicResource PincelPotencialRestaurador}"/>
                                            <TextBlock Text="Restaurador" FontSize="11.5"
                                                       Foreground="{StaticResource BrushTx2}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border Style="{StaticResource EstiloLegendaDot}"
                                                    Background="{DynamicResource PincelPotencialEstressor}"/>
                                            <TextBlock Text="Estressor" FontSize="11.5"
                                                       Foreground="{StaticResource BrushTx2}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource EstiloLegendaDot}"
                                                    Background="{DynamicResource PincelPotencialNeutro}"/>
                                            <TextBlock Text="Neutro" FontSize="11.5"
                                                       Foreground="{StaticResource BrushTx2}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- A legenda textual das colunas foi REMOVIDA. A legenda de
                                         cores acima permanece. -->

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Objetos por Potencial Homeodinâmico"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTx}"/>
                                        <TextBlock x:Name="TextoResumoDeObjetos"
                                                   Text="Selecione um cenário para listar os objetos"
                                                   FontSize="11.5" Foreground="{StaticResource BrushTx3}"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Estado do ajuste da Camada 1. Fica no rodapé, e não em caixa
                                     de diálogo, porque precisa estar visível o tempo todo: os
                                     números da tabela mudam de significado conforme os termos da
                                     Equação 3 que entraram no ajuste, e nada mais na tela
                                     denuncia essa diferença. Oculto quando não há o que relatar. -->
                                <Border x:Name="RodapeDaCamada1"
                                        DockPanel.Dock="Bottom"
                                        Visibility="Collapsed"
                                        BorderBrush="{StaticResource BrushBdSoft}"
                                        BorderThickness="0,1,0,0"
                                        Padding="20,7">
                                    <TextBlock x:Name="TextoAvisosDaCamada1"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource BrushTx3}"/>
                                </Border>

                                <!-- Sem altura fixa: o DockPanel a estica dentro da sua linha. -->
                                <DataGrid x:Name="TabelaDeObjetos"
                                          VerticalAlignment="Stretch"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True"
                                          GridLinesVisibility="None"
                                          BorderBrush="{StaticResource BrushBd}"
                                          BorderThickness="1"
                                          Background="White"
                                          RowBackground="White"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                    <!-- A classificação PH é carregada pela COR DO TEXTO da linha:
                                         a mesma cor da legenda acima. -->
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Classificacao}" Value="Restaurador">
                                                    <Setter Property="Foreground" Value="{DynamicResource PincelPotencialRestaurador}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Classificacao}" Value="Estressor">
                                                    <Setter Property="Foreground" Value="{DynamicResource PincelPotencialEstressor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Classificacao}" Value="Neutro">
                                                    <Setter Property="Foreground" Value="{DynamicResource PincelPotencialNeutro}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ELEMENTO"
                                                            Binding="{Binding NomeDoObjeto}"
                                                            Width="*"
                                                            ElementStyle="{StaticResource ColunaTextoHerdandoCor}"/>
                                        <!-- A identidade do elemento é objeto × cenário: sem esta
                                             coluna, duas linhas do mesmo objeto em cenários
                                             diferentes pareceriam duplicatas. -->
                                        <DataGridTextColumn Header="CENÁRIO"
                                                            Binding="{Binding Cenario}"
                                                            Width="140"
                                                            ElementStyle="{StaticResource ColunaTextoHerdandoCor}"/>
                                        <DataGridTextColumn Header="POTENCIAL"
                                                            Binding="{Binding ClassificacaoRotulo}"
                                                            Width="120"
                                                            ElementStyle="{StaticResource ColunaTextoHerdandoCor}"/>
                                        <!-- Texto já formatado, e não o número cru: objetos sem
                                             fixação válida não têm índice, e "NaN" numa coluna de
                                             resultado sugere erro onde há ausência de medida. O
                                             SortMemberPath preserva a ordenação numérica. -->
                                        <DataGridTextColumn Header="PH (−1 a +1)"
                                                            Binding="{Binding PontuacaoTexto}"
                                                            SortMemberPath="Pontuacao"
                                                            Width="100"
                                                            ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                        <!-- Diâmetro pupilar ABSOLUTO, ao lado do índice: sem
                                             fotometria da cena, o reflexo fotomotor se aloja no
                                             efeito de elemento (§3.6.4). Se os elementos de menor
                                             diâmetro forem os mesmos classificados como
                                             restauradores, o índice está confundido com o brilho. -->
                                        <DataGridTextColumn Header="DIÂMETRO PUPILAR"
                                                            Binding="{Binding DiametroPupilarTexto}"
                                                            SortMemberPath="DiametroPupilarMm"
                                                            Width="130"
                                                            ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                        <!-- Ambiente vigente durante as fixações do elemento: a
                                             leitura de sensor mais recente igual ou anterior a cada
                                             fixação. Travessão quando não houve leitura vigente. -->
                                        <DataGridTextColumn Header="TEMPERATURA"
                                                            Binding="{Binding Temperatura}"
                                                            Width="115"
                                                            ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                        <DataGridTextColumn Header="UMIDADE"
                                                            Binding="{Binding Umidade}"
                                                            Width="100"
                                                            ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                        <!-- Coluna G do arquivo de sensores ("RUÍDO (dB)"): média
                                             das leituras vigentes, como temperatura e umidade. -->
                                        <DataGridTextColumn Header="RUÍDO"
                                                            Binding="{Binding Ruido}"
                                                            Width="95"
                                                            ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                        <!-- Coluna F do arquivo de sensores: indicador de dois
                                             estados. Usa o estilo de TEXTO, e não o de número,
                                             porque a célula passou a ser rótulo, não contagem. -->
                                        <DataGridTextColumn Header="PRESENÇA DE CO"
                                                            Binding="{Binding PresencaDeGas}"
                                                            Width="150"
                                                            ElementStyle="{StaticResource ColunaTextoHerdandoCor}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                        </DockPanel>

                        <!-- ── Auditoria da sessão: eventos detectados (oculto até clicar no botão) ── -->
                        <DockPanel x:Name="PainelAuditoria" Background="White"
                                   Visibility="Collapsed">

                            <!-- Cabeçalho da tabela -->
                            <Border DockPanel.Dock="Top"
                                    Padding="20,10"
                                    BorderBrush="{StaticResource BrushBdSoft}"
                                    BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Border Width="22" Height="22" CornerRadius="5"
                                            Background="{StaticResource BrushAccentSoft}"
                                            VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Path Data="M3 4h18a1.5 1.5 0 0 1 1.5 1.5v12A1.5 1.5 0 0 1 21 20H3a1.5 1.5 0 0 1-1.5-1.5V5.5A1.5 1.5 0 0 1 3 4Z M3 10h18 M3 16h18 M9 4v16 M15 4v16"
                                              Stroke="#0E6B6B" StrokeThickness="1.4" Fill="Transparent"
                                              Width="12" Height="12" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Mesma legenda de cores da tabela de objetos: na auditoria a
                                         classificação é a do evento, resolvida a partir dos objetos
                                         que ele observou. -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border Style="{StaticResource EstiloLegendaDot}"
                                                    Background="{DynamicResource PincelPotencialRestaurador}"/>
                                            <TextBlock Text="Restaurador" FontSize="11.5"
                                                       Foreground="{StaticResource BrushTx2}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border Style="{StaticResource EstiloLegendaDot}"
                                                    Background="{DynamicResource PincelPotencialEstressor}"/>
                                            <TextBlock Text="Estressor" FontSize="11.5"
                                                       Foreground="{StaticResource BrushTx2}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border Style="{StaticResource EstiloLegendaDot}"
                                                    Background="{DynamicResource PincelPotencialNeutro}"/>
                                            <TextBlock Text="Neutro" FontSize="11.5"
                                                       Foreground="{StaticResource BrushTx2}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.38">
                                            <Border Style="{StaticResource EstiloLegendaDot}"
                                                    Background="{DynamicResource PincelPotencialNeutro}"/>
                                            <TextBlock Text="Fora do intervalo considerado" FontSize="11.5"
                                                       Foreground="{StaticResource BrushTx2}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Eventos Detectados (auditoria)"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTx}"/>
                                        <TextBlock x:Name="TextoResumoDeEventos"
                                                   Text="Todos os eventos das sessões filtradas"
                                                   FontSize="11.5" Foreground="{StaticResource BrushTx3}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <DataGrid x:Name="TabelaDeEventos"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserSortColumns="True"
                                      GridLinesVisibility="None"
                                      BorderThickness="0"
                                      Background="White"
                                      RowBackground="White"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                                <!-- Duas informações na mesma linha: a COR do texto é a
                                     classificação de potencial (as mesmas da legenda), e a OPACIDADE
                                     diz se o evento entrou nos cálculos — esmaecido = fora da janela
                                     temporal de análise, portanto descartado. -->
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Classificacao}" Value="Restaurador">
                                                <Setter Property="Foreground" Value="{DynamicResource PincelPotencialRestaurador}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Classificacao}" Value="Estressor">
                                                <Setter Property="Foreground" Value="{DynamicResource PincelPotencialEstressor}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Classificacao}" Value="Neutro">
                                                <Setter Property="Foreground" Value="{DynamicResource PincelPotencialNeutro}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DentroDaJanelaDeAnalise}" Value="False">
                                                <Setter Property="Opacity" Value="0.38"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <!-- Tempo decorrido desde o início da sessão, minuto:segundo:
                                         milissegundo. Ordena pelo TimeSpan, não pelo texto. -->
                                    <DataGridTextColumn Header="TEMPO (mm:ss:ms)"
                                                        Binding="{Binding TempoDesdeOInicio}"
                                                        SortMemberPath="TempoDesdeOInicioDaSessao"
                                                        Width="120"
                                                        ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                    <DataGridTextColumn Header="TIPO"
                                                        Binding="{Binding TipoDoEvento}"
                                                        Width="90"
                                                        ElementStyle="{StaticResource ColunaTextoHerdandoCor}"/>
                                    <!-- Classificação DESTA fixação, não a do objeto: o mesmo
                                         elemento pode aparecer aqui ora neutro, ora estressor,
                                         ora restaurador. Vazia nos saccades, que nunca são
                                         classificados. -->
                                    <DataGridTextColumn Header="CLASSIFICAÇÃO"
                                                        Binding="{Binding ClassificacaoRotulo}"
                                                        Width="115"
                                                        ElementStyle="{StaticResource ColunaTextoHerdandoCor}"/>
                                    <DataGridTextColumn Header="DURAÇÃO (ms)"
                                                        Binding="{Binding DuracaoMs, StringFormat=N1}"
                                                        Width="100"
                                                        ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                    <DataGridTextColumn Header="INÍCIO"
                                                        Binding="{Binding TimestampInicio, StringFormat=HH:mm:ss.fff}"
                                                        Width="110"
                                                        ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                    <DataGridTextColumn Header="FIM"
                                                        Binding="{Binding TimestampFim, StringFormat=HH:mm:ss.fff}"
                                                        Width="110"
                                                        ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                    <DataGridTextColumn Header="OBJETO"
                                                        Binding="{Binding NomesDeObjetos}"
                                                        Width="*"
                                                        ElementStyle="{StaticResource ColunaTextoHerdandoCor}"/>
                                    <DataGridTextColumn Header="PONTO X"
                                                        Binding="{Binding PontoX, StringFormat=N4}"
                                                        Width="82"
                                                        ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                    <DataGridTextColumn Header="PONTO Y"
                                                        Binding="{Binding PontoY, StringFormat=N4}"
                                                        Width="82"
                                                        ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                    <DataGridTextColumn Header="PONTO Z"
                                                        Binding="{Binding PontoZ, StringFormat=N4}"
                                                        Width="82"
                                                        ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                    <DataGridTextColumn Header="PUPILA ESQ (mm)"
                                                        Binding="{Binding DiametroPupilaEsquerda, StringFormat=N4}"
                                                        Width="115"
                                                        ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                    <DataGridTextColumn Header="PUPILA DIR (mm)"
                                                        Binding="{Binding DiametroPupilaDireita, StringFormat=N4}"
                                                        Width="115"
                                                        ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                    <!-- O número que decidiu a classificação: ΔD da fixação menos
                                         a média do participante. Negativo é constrição. -->
                                    <DataGridTextColumn Header="ΔD CENTRADO (mm)"
                                                        Binding="{Binding DeltaPupilarCentradoTexto}"
                                                        SortMemberPath="DeltaPupilarCentrado"
                                                        Width="130"
                                                        ElementStyle="{StaticResource ColunaNumeroHerdandoCor}"/>
                                    <DataGridTextColumn Header="TENDÊNCIA"
                                                        Binding="{Binding TendenciaPupilar}"
                                                        Width="100"
                                                        ElementStyle="{StaticResource ColunaTextoHerdandoCor}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                    </Grid>
                  </DockPanel>
                </TabItem>

                <!-- ── §5.5.2 — Aba de dados do grupo ── -->
                <TabItem Header="Dados do Grupo">
                  <DockPanel>

                    <!-- Seletores de eixo do gráfico dinâmico. Não há filtros de subconjunto nesta
                         aba: o gráfico usa todos os participantes carregados. -->
                    <Border DockPanel.Dock="Top"
                            Background="White"
                            BorderBrush="{StaticResource BrushBd}"
                            BorderThickness="0,0,0,1"
                            Padding="20,12">
                      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <ContentControl Style="{StaticResource EstiloRotuloDeFiltro}"/>

                        <!-- Eixos do gráfico dinâmico. As duas listas deixaram de ser iguais: X
                             oferece características do indivíduo e Y, índices de estresse. -->
                        <StackPanel Margin="0,0,14,0">
                          <TextBlock Text="EIXO X - CARACTERÍSTICA DO INDIVÍDUO"
                                     FontSize="10.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource BrushTx3}" Margin="0,0,0,4"/>
                          <ComboBox x:Name="SeletorDoEixoX" Width="260" IsEnabled="False"
                                    SelectionChanged="SelecaoDeGrupoAlterada"/>
                        </StackPanel>

                        <StackPanel>
                          <TextBlock Text="EIXO Y - ÍNDICE DE ESTRESSE"
                                     FontSize="10.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource BrushTx3}" Margin="0,0,0,4"/>
                          <ComboBox x:Name="SeletorDoEixoY" Width="260" IsEnabled="False"
                                    SelectionChanged="SelecaoDeGrupoAlterada"/>
                        </StackPanel>

                      </WrapPanel>
                    </Border>

                    <!-- Aviso exibido enquanto o Arquivo 4 não estiver carregado -->
                    <TextBlock x:Name="TextoPlaceholderContextualizacao"
                               DockPanel.Dock="Top"
                               Text="Carregue o arquivo de formulários (Etapa 4) na tela inicial para ver os dados de contextualização."
                               FontSize="12.5"
                               Foreground="{StaticResource BrushTxMute}"
                               TextWrapping="Wrap"
                               Margin="20,16,20,0"/>

                    <!-- Apenas o gráfico da combinação selecionada (PH_e × faixa do IEEE).
                         Nenhuma tabela e nenhum outro gráfico nesta aba. -->
                    <ScrollViewer Margin="20,12,20,14"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <StackPanel x:Name="PainelDeDispersoes"/>
                    </ScrollViewer>
                  </DockPanel>
                </TabItem>

                <!-- ── §5.5.3 — Aba de dados de cada participante ── -->
                <TabItem Header="Dados do Participante">
                  <DockPanel>

                    <Border DockPanel.Dock="Top"
                            Background="White"
                            BorderBrush="{StaticResource BrushBd}"
                            BorderThickness="0,0,0,1"
                            Padding="20,12">
                      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <ContentControl Style="{StaticResource EstiloRotuloDeFiltro}"/>

                        <StackPanel Margin="0,0,14,0">
                          <TextBlock Text="ID DO PARTICIPANTE" FontSize="10.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource BrushTx3}" Margin="0,0,0,4"/>
                          <ComboBox x:Name="SeletorDeParticipante" Width="180" IsEnabled="False"
                                    SelectionChanged="SelecaoDeContextualizacaoAlterada"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,14,0">
                          <TextBlock Text="FORMULÁRIO" FontSize="10.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource BrushTx3}" Margin="0,0,0,4"/>
                          <ComboBox x:Name="SeletorDeFormulario" Width="240" IsEnabled="False"
                                    SelectionChanged="SelecaoDeContextualizacaoAlterada"/>
                        </StackPanel>

                        <!-- O seletor exclusivo do HMD foi REMOVIDO. Ele existia porque os
                             identificadores do rastreamento não correspondiam aos dos formulários;
                             com os arquivos de cenário, os 26 coincidem, e o seletor do topo passa
                             a governar também esta categoria. -->

                        <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                          <TextBlock x:Name="TextoDeltaCortisol"
                                     Text="Delta de cortisol: —"
                                     FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource BrushTx}"/>
                          <!-- Descrição, não causa. O §3.6.5 do TextoFinal pede a "supressão ou
                               reenquadramento do 'delta = impacto' como estatística descritiva sem
                               leitura causal": com três rodadas ao longo de meses, sem grupo de
                               controle e com a variabilidade dia a dia do cortisol, o delta não
                               estima efeito da imersão. -->
                          <TextBlock Text="Variação entre a coleta basal e a final"
                                     FontSize="11" Foreground="{StaticResource BrushTx3}"/>
                        </StackPanel>

                      </WrapPanel>
                    </Border>

                    <TextBlock x:Name="TextoPlaceholderParticipante"
                               DockPanel.Dock="Top"
                               Text="Carregue o arquivo de formulários (Etapa 4) na tela inicial para ver os dados por participante."
                               FontSize="12.5"
                               Foreground="{StaticResource BrushTxMute}"
                               TextWrapping="Wrap"
                               Margin="20,16,20,0"/>

                    <ScrollViewer Margin="20,12,20,14"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <StackPanel>

                        <!-- Faixa de destaques: o retrato do participante, igual em todos os
                             formulários. Ver CartaoDeDestaqueDoParticipante. -->
                        <ItemsControl x:Name="FaixaDeDestaques"
                                      Margin="0,0,0,16"
                                      ItemTemplate="{StaticResource ModeloDeCartaoDeDestaque}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock x:Name="TextoTituloDoFormulario"
                                   Text="Dados do formulário"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTx}"
                                   Margin="0,0,0,8"/>


                        <!-- Grupos recolhíveis. IsSharedSizeScope alinha a coluna de rótulos entre
                             TODOS os grupos: sem ele, cada bloco calcularia a própria largura e a
                             coluna de valores serpentearia de um grupo para o outro. -->
                        <ItemsControl x:Name="ListaDeGruposDoFormulario"
                                      Grid.IsSharedSizeScope="True"
                                      ItemTemplate="{StaticResource ModeloDeGrupoDeFormulario}"/>

                        <!-- Objetos mais observados, um cartão por elemento, ABAIXO das tabelas.
                             Preenchida apenas na categoria "Dados do HMD - RV"; vazia, não ocupa
                             espaço nas demais. -->
                        <ItemsControl x:Name="FaixaDeObjetosObservados"
                                      Margin="0,4,0,0"
                                      ItemTemplate="{StaticResource ModeloDeCartaoDeDestaque}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Gráficos de cortisol: preenchidos apenas no formulário "Níveis de cortisol" -->
                        <StackPanel x:Name="PainelDeGraficosDeCortisol" Margin="0,16,0,0"/>
                      </StackPanel>
                    </ScrollViewer>
                  </DockPanel>
                </TabItem>

              </TabControl>
            </DockPanel>

        </Grid>
    </DockPanel>
</Window>
