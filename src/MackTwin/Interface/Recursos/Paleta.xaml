<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:r="clr-namespace:MackTwin.Interface.Recursos">

    <!-- ── Pincéis: os valores vêm de Paleta.cs, a fonte única das cores ──── -->
    <SolidColorBrush x:Key="BrushSurface"   Color="{x:Static r:Paleta.Superficie}"/>
    <SolidColorBrush x:Key="BrushSubtle"    Color="{x:Static r:Paleta.Sutil}"/>
    <SolidColorBrush x:Key="BrushBd"        Color="{x:Static r:Paleta.Borda}"/>
    <SolidColorBrush x:Key="BrushBdBrand"   Color="{x:Static r:Paleta.BordaMarca}"/>
    <SolidColorBrush x:Key="BrushTx"        Color="{x:Static r:Paleta.Texto}"/>
    <SolidColorBrush x:Key="BrushTx2"       Color="{x:Static r:Paleta.Texto2}"/>
    <SolidColorBrush x:Key="BrushTx3"       Color="{x:Static r:Paleta.Texto3}"/>
    <SolidColorBrush x:Key="BrushBrand"     Color="{x:Static r:Paleta.Marca}"/>
    <SolidColorBrush x:Key="BrushBrandDark" Color="{x:Static r:Paleta.MarcaEscura}"/>
    <SolidColorBrush x:Key="BrushBrandSoft" Color="{x:Static r:Paleta.MarcaSuave}"/>
    <SolidColorBrush x:Key="BrushDisabled"  Color="{x:Static r:Paleta.Desativado}"/>
    <SolidColorBrush x:Key="BrushTxDisabled" Color="{x:Static r:Paleta.TextoDesativado}"/>

    <!-- Conversor padrão do WPF para ligar Visibility a propriedades booleanas. -->
    <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>

    <!-- ── Superfícies ──────────────────────────────────────────────────── -->
    <Style x:Key="EstiloCartao" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBd}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="EstiloTituloDeSecao" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTx3}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="EstiloCaixaDeTexto" TargetType="TextBox">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBd}"/>
        <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTx}"/>
    </Style>

    <!-- ── Botões ───────────────────────────────────────────────────────── -->
    <Style x:Key="EstiloBotaoPrincipal" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource BrushBrand}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBrandDark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushDisabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTxDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EstiloBotaoPrincipalCompacto" TargetType="Button" BasedOn="{StaticResource EstiloBotaoPrincipal}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>

    <Style x:Key="EstiloBotaoSecundario" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrushTx}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBd}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBrandSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBrand}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushBrandDark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushTxDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão-texto (ex.: "+ adicionar") e botão-ícone (✎ ✕) dentro dos cartões -->
    <Style x:Key="EstiloBotaoLink" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrushBrand}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter VerticalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushBrandDark}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EstiloBotaoIcone" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrushTx3}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushBrand}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Segmento de período (1 h · 6 h · 24 h · 7 d · 30 d · Tudo) ──── -->
    <Style x:Key="EstiloSegmento" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTx2}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBrandSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushBrandDark}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBrand}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Interruptor "Editar": o estado global da janela ──────────────── -->
    <Style x:Key="EstiloInterruptor" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Trilho" Width="44" Height="24" CornerRadius="12" Background="{StaticResource BrushDisabled}">
                        <Ellipse x:Name="Botao" Width="18" Height="18" Fill="White"
                                 HorizontalAlignment="Left" Margin="3,0,3,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Trilho" Property="Background" Value="{StaticResource BrushBrand}"/>
                            <Setter TargetName="Botao" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Trilho" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Lista de salas: item com barra vermelha quando selecionado ───── -->
    <Style x:Key="EstiloItemDeSala" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="8" Padding="10,8" Margin="0,0,0,4"
                            Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSubtle}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBrandSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBrand}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Partes do cartão que só existem no modo Editar: o rodapé compacto nos cartões
         não selecionados e o cadastro completo no cartão selecionado. -->
    <Style x:Key="EstiloRodapeCompacto" TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ModoEdicao}" Value="True"/>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EstiloCadastroDaSala" TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ModoEdicao}" Value="True"/>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── Abas: texto com sublinhado vermelho na ativa ─────────────────── -->
    <Style x:Key="EstiloAba" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource BrushTx3}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Padding="4,6,4,8" Margin="0,0,18,0"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                        <ContentPresenter ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushTx}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushBrand}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushBrand}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
