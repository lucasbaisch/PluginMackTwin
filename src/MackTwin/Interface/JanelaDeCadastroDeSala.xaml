<Window x:Class="MackTwin.Interface.JanelaDeCadastroDeSala"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:MackTwin.Interface.Recursos"
        Title="Adicionar sala"
        Height="330" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Background>
        <SolidColorBrush Color="{x:Static r:Paleta.Fundo}"/>
    </Window.Background>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MackTwin;component/Interface/Recursos/Paleta.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="16" Style="{StaticResource EstiloCartao}" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BrushBrandSoft}" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushBrandDark}" FontSize="11.5"
                           Text="O Nome é o que casa com o Room do modelo (Número ou Nome do Room). O Código é o HOSTNAME do sensor na planilha: as leituras desse sensor vão para este ambiente. Maiúsculas, espaços, hífens e sublinhados não importam na comparação."/>
            </Border>

            <TextBlock Grid.Row="1" Text="Nome do Ambiente" Foreground="{StaticResource BrushTx2}" Margin="0,0,0,4"/>
            <TextBox Grid.Row="2" x:Name="CaixaNome" Style="{StaticResource EstiloCaixaDeTexto}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="3" Text="Código do Ambiente (ex.: BR_UPM-CPS-EDU_T00-FABLAB-MAMB-TU-SHT40_2026)"
                       Foreground="{StaticResource BrushTx2}" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <TextBox Grid.Row="4" x:Name="CaixaCodigo" Style="{StaticResource EstiloCaixaDeTexto}" Margin="0,0,0,12"
                     CharacterCasing="Upper"/>

            <TextBlock Grid.Row="5" x:Name="TextoResultado" Foreground="{StaticResource BrushBrandDark}" TextWrapping="Wrap"
                       VerticalAlignment="Top"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource EstiloBotaoSecundario}" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="BotaoSalvar" Content="Adicionar" Style="{StaticResource EstiloBotaoPrincipal}"
                        IsDefault="True" Click="BotaoSalvar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
