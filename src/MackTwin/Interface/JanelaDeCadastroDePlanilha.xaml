<Window x:Class="MackTwin.Interface.JanelaDeCadastroDePlanilha"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:MackTwin.Interface.Recursos"
        Title="Adicionar planilha de sensores"
        Height="380" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Background>
        <SolidColorBrush Color="{x:Static r:Paleta.Fundo}"/>
    </Window.Background>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MackTwin;component/Interface/Recursos/Paleta.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="16" Style="{StaticResource EstiloCartao}" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BrushBrandSoft}" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                <TextBlock x:Name="TextoSala" TextWrapping="Wrap" Foreground="{StaticResource BrushBrandDark}" FontSize="11.5"/>
            </Border>

            <TextBlock Grid.Row="1" Text="Nome (como aparece no painel)" Foreground="{StaticResource BrushTx2}" Margin="0,0,0,4"/>
            <TextBox Grid.Row="2" x:Name="CaixaNome" Style="{StaticResource EstiloCaixaDeTexto}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="3" Foreground="{StaticResource BrushTx2}" Margin="0,0,0,4" TextWrapping="Wrap"
                       Text="Endereço da planilha Google — o de edição serve (…/spreadsheets/d/{id}/edit?gid=0). A planilha precisa estar compartilhada como &quot;qualquer pessoa com o link&quot;."/>
            <TextBox Grid.Row="4" x:Name="CaixaUrl" Style="{StaticResource EstiloCaixaDeTexto}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="5" x:Name="TextoResultado" Foreground="{StaticResource BrushTx2}" TextWrapping="Wrap"
                       VerticalAlignment="Top"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BotaoTestar" Content="Testar conexão" Style="{StaticResource EstiloBotaoSecundario}"
                        Margin="0,0,8,0" Click="BotaoTestar_Click"/>
                <Button Content="Cancelar" Style="{StaticResource EstiloBotaoSecundario}" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="BotaoSalvar" Content="Salvar" Style="{StaticResource EstiloBotaoPrincipal}"
                        IsDefault="True" Click="BotaoSalvar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
