<Window x:Class="MackTwin.Interface.JanelaMackTwin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:MackTwin.Interface.Recursos"
        Title="MackTwin — Painel de sensores por ambiente"
        Height="800" Width="1240"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Background>
        <SolidColorBrush Color="{x:Static r:Paleta.Fundo}"/>
    </Window.Background>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MackTwin;component/Interface/Recursos/Paleta.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Cabeçalho: logos Mackenzie e Limiar · título · status · controles · interruptor ── -->
        <Border Grid.Row="0" Style="{StaticResource EstiloCartao}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/MackTwin;component/Assets/logo-mackenzie.png"
                       Height="40" VerticalAlignment="Center" Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <Image Grid.Column="1" Source="/MackTwin;component/Assets/logo-limiar.png"
                       Height="46" VerticalAlignment="Center" Margin="0,0,18,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <Border Grid.Column="2" Width="1" Background="{StaticResource BrushBd}" Margin="0,2,18,2"/>

                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="MackTwin - Gêmeo Digital Mackenzie" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource BrushBrand}"/>
                    <TextBlock x:Name="TextoStatus" Text="Aguardando a primeira atualização…"
                               Foreground="{StaticResource BrushTx3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TextoResumoDoCiclo" Text=""
                               Foreground="{StaticResource BrushTx3}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <ProgressBar x:Name="Spinner" Width="110" Height="3" IsIndeterminate="True"
                                 Foreground="{StaticResource BrushBrand}" BorderThickness="0"
                                 Visibility="Collapsed" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="CaixaAuto" Content="Atualizar a cada 60 s" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource BrushTx2}"/>
                    <Button x:Name="BotaoAtualizar" Content="Atualizar agora"
                            Style="{StaticResource EstiloBotaoPrincipal}" Click="BotaoAtualizar_Click"/>
                    <Border Width="1" Background="{StaticResource BrushBd}" Margin="18,2,18,2"/>
                    <TextBlock x:Name="TextoEditar" Text="Editar" Foreground="{StaticResource BrushTx3}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ToggleButton x:Name="InterruptorDeEdicao" Style="{StaticResource EstiloInterruptor}"
                                  VerticalAlignment="Center"
                                  ToolTip="Modo Editar: cadastre as planilhas dentro das salas"
                                  Checked="InterruptorDeEdicao_Alterado" Unchecked="InterruptorDeEdicao_Alterado"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Corpo: Salas | Ambiente ──────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Salas (no modo Editar, cada cartão cadastra as suas planilhas) -->
            <Border Grid.Column="0" Style="{StaticResource EstiloCartao}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="TextoTituloDeSalas" Text="SALAS" Style="{StaticResource EstiloTituloDeSecao}"/>
                        <TextBlock x:Name="TextoDicaDeEdicao" Visibility="Collapsed" TextWrapping="Wrap"
                                   Text="Cadastre as planilhas dentro da sala a que pertencem."
                                   FontSize="10.5" Foreground="{StaticResource BrushBrandDark}" Margin="0,-6,0,10"/>
                    </StackPanel>

                    <Expander DockPanel.Dock="Bottom" x:Name="ExpansorSemSala" Header="Sem sala" Margin="0,8,0,0"
                              Foreground="{StaticResource BrushTx2}">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="SENSORES" Style="{StaticResource EstiloTituloDeSecao}" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="ListaDeSensoresSemSala">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource BrushTx3}"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel x:Name="PainelDePlanilhasSemSala" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock Text="PLANILHAS" Style="{StaticResource EstiloTituloDeSecao}" Margin="0,0,0,4"/>
                                <ItemsControl x:Name="ListaDePlanilhasSemSala">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Nome}" FontSize="11" Foreground="{StaticResource BrushTx2}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="atribuir à sala selecionada" Style="{StaticResource EstiloBotaoLink}"
                                                        Margin="8,0,8,0" Tag="{Binding}" Click="AtribuirPlanilha_Click"/>
                                                <Button Grid.Column="2" Content="&#x2715;" Style="{StaticResource EstiloBotaoIcone}"
                                                        ToolTip="Remover do cadastro" Tag="{Binding}" Click="RemoverPlanilha_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <ListBox x:Name="ListaDeAmbientes" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource EstiloItemDeSala}"
                             SelectionChanged="ListaDeAmbientes_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="11" Height="11" Fill="{Binding Cor}"
                                             VerticalAlignment="Top" Margin="0,4,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTx}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detalhe}" FontSize="11"
                                                   Foreground="{StaticResource BrushTx2}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Casamento}" FontSize="10.5"
                                                   Foreground="{StaticResource BrushTx3}"/>

                                        <!-- modo Editar, cartão NÃO selecionado -->
                                        <StackPanel Style="{StaticResource EstiloRodapeCompacto}" Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding ResumoDePlanilhas}" FontSize="10.5"
                                                       Foreground="{StaticResource BrushTx3}" VerticalAlignment="Center"/>
                                            <TextBlock Text="  ·  " FontSize="10.5" Foreground="{StaticResource BrushTx3}" VerticalAlignment="Center"/>
                                            <Button Content="+ adicionar" Style="{StaticResource EstiloBotaoLink}"
                                                    Tag="{Binding}" Click="AdicionarPlanilhaNaSala_Click"/>
                                        </StackPanel>

                                        <!-- modo Editar, cartão selecionado: o cadastro desta sala -->
                                        <StackPanel Style="{StaticResource EstiloCadastroDaSala}">
                                            <Border Height="1" Background="{StaticResource BrushBdBrand}" Margin="0,10,0,8"/>
                                            <TextBlock Text="PLANILHAS DESTA SALA" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushBrandDark}" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Planilhas}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding Ativa, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                      ToolTip="Ativa no ciclo de atualização"
                                                                      Checked="PlanilhaAtivaAlterada" Unchecked="PlanilhaAtivaAlterada"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Nome}" FontSize="11.5"
                                                                       Foreground="{StaticResource BrushTx}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"/>
                                                            <Button Grid.Column="2" Content="&#x270E;" Style="{StaticResource EstiloBotaoIcone}"
                                                                    ToolTip="Editar nome ou endereço" Tag="{Binding}" Click="EditarPlanilha_Click"/>
                                                            <Button Grid.Column="3" Content="&#x2715;" Style="{StaticResource EstiloBotaoIcone}"
                                                                    ToolTip="Remover do cadastro" Tag="{Binding}" Click="RemoverPlanilha_Click"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="{Binding RotuloDeAdicionar}" Style="{StaticResource EstiloBotaoPrincipalCompacto}"
                                                    HorizontalAlignment="Stretch" Margin="0,4,0,2"
                                                    Tag="{Binding}" Click="AdicionarPlanilhaNaSala_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Sala selecionada: três visualizações -->
            <Border Grid.Column="2" Style="{StaticResource EstiloCartao}" Padding="18,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="TextoTituloDaSala" Text="Selecione uma sala"
                                   FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource BrushTx}"/>
                        <TextBlock x:Name="TextoResumoDaSala" Foreground="{StaticResource BrushTx2}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="A lista à esquerda mostra as salas reconhecidas nas planilhas. Clique numa sala aqui, ou num Room no modelo."/>
                    </StackPanel>

                    <TabControl x:Name="Abas" BorderThickness="0" Background="Transparent" Padding="0,12,0,0"
                                ItemContainerStyle="{StaticResource EstiloAba}">
                        <TabItem Header="Ao vivo">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="PainelDeCartoes" Margin="0,4,0,0"/>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Série temporal">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,10">
                                    <TextBlock Text="Janela:" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTx2}" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="SeletorDeJanela" Width="170"
                                              SelectionChanged="SeletorDeJanela_SelectionChanged"/>
                                </StackPanel>
                                <ContentControl x:Name="PainelDoGrafico"/>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="No modelo">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock x:Name="TextoCasamento" TextWrapping="Wrap"
                                           Foreground="{StaticResource BrushTx2}" Margin="0,0,0,14"
                                           Text="Nenhum ciclo concluído ainda."/>
                                <WrapPanel>
                                    <Button x:Name="BotaoPintar" Content="Pintar salas na vista ativa"
                                            Style="{StaticResource EstiloBotaoSecundario}" Click="BotaoPintar_Click"/>
                                    <Button x:Name="BotaoLimpar" Content="Limpar pintura"
                                            Style="{StaticResource EstiloBotaoSecundario}" Click="BotaoLimpar_Click"/>
                                    <Button x:Name="BotaoVista3D" Content="Gerar vista 3D de conforto"
                                            Style="{StaticResource EstiloBotaoSecundario}" Click="BotaoVista3D_Click"/>
                                    <Button x:Name="BotaoMostrar" Content="Mostrar sala selecionada no modelo"
                                            Style="{StaticResource EstiloBotaoSecundario}" Click="BotaoMostrar_Click"/>
                                    <Button x:Name="BotaoDiagnostico" Content="Diagnóstico do modelo"
                                            ToolTip="Lista Rooms, vista ativa, categorias e casamentos nos avisos (e copia para a área de transferência)"
                                            Style="{StaticResource EstiloBotaoSecundario}" Click="BotaoDiagnostico_Click"/>
                                </WrapPanel>
                                <TextBlock Text="LEGENDA" Style="{StaticResource EstiloTituloDeSecao}" Margin="0,10,0,8"/>
                                <StackPanel x:Name="PainelDeLegenda" Orientation="Horizontal"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushTx3}" FontSize="11" Margin="0,14,0,0"
                                           Text="A cor é da ÚLTIMA leitura, na janela escolhida em &quot;Série temporal&quot;. A pintura usa o mecanismo nativo do Revit: o estado de cada sala vai para o parâmetro de Room &quot;MackTwin Conforto&quot; e o esquema de cores &quot;MackTwin Conforto&quot; é aplicado à vista ativa; &quot;Limpar pintura&quot; tira o esquema da vista. Em 3D o Revit só desenha Rooms com o cálculo de volumes ligado — &quot;Gerar vista 3D&quot; cuida disso."/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── Avisos ──────────────────────────────────────────────────── -->
        <Expander Grid.Row="2" x:Name="ExpansorDeAvisos" Header="Avisos do último ciclo"
                  Margin="0,14,0,0" Foreground="{StaticResource BrushTx2}">
            <TextBox x:Name="TextoAvisos" IsReadOnly="True" TextWrapping="Wrap" Height="120"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                     Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBd}"
                     Padding="8" Margin="0,6,0,0"/>
        </Expander>
    </Grid>
</Window>
